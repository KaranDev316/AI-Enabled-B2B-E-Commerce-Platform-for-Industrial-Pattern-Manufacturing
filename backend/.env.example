APP_ENV=development
# Replace placeholders privately. Keep the two database names separate.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/kpc_dev
TEST_DATABASE_URL=postgresql+psycopg://YOUR_TEST_USER:YOUR_TEST_PASSWORD@127.0.0.1:5432/kpc_test
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Session policy is configured when S01 authentication is implemented.
SESSION_TTL_SECONDS=
LOG_LEVEL=INFO
MODEL_PATH=ml/kpc_model.joblib
# Configure these for private uploads in the relevant slice.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
PORT=8000
